version: '3'
tasks:
  default:
    cmds: [task --list]
  install:
    desc: Install backend and frontend dependencies
    cmds:
      - uv sync
      - task: ui:install
      - task: api:generate
  ui:install:
    dir: frontend
    cmds:
      - pnpm install
  setup:
    desc: Install dependencies and initialize database
    cmds:
      - task: install
      - uv run python -m app.cli init-db
      - task: ui:format
      - task: hooks:install
  hooks:install:
    desc: Install pre-commit hooks in Git projects
    status:
      - uv run python -c "from pathlib import Path; import sys; sys.exit(0 if not Path('.git').exists() else 1)"
    cmds:
      - uv run pre-commit install
  api:generate:
    desc: Export FastAPI OpenAPI and regenerate typed frontend client
    cmds:
      - uv run python -m app.cli openapi
      - task: ui:api:generate
  ui:api:generate:
    dir: frontend
    cmds:
      - pnpm api:generate
  api:check:
    desc: Fail if generated TypeScript API types are stale
    cmds:
      - uv run python -m app.cli openapi
      - task: ui:api:check
  ui:api:check:
    dir: frontend
    cmds:
      - pnpm api:check
  dev:
    desc: API and Vite hot reload
    cmds:
      - task: api:generate
      - task --parallel api:dev ui:dev
  api:dev:
    cmds:
      - uv run python -m app.cli serve --reload
  ui:dev:
    dir: frontend
    cmds:
      - pnpm dev
  build:
    desc: Build frontend and Python distribution
    cmds:
      - task: api:generate
      - task: ui:build
      - uv build
  ui:build:
    dir: frontend
    cmds:
      - pnpm build
  serve:
    desc: Run API and Caddy after building
    cmds:
      - task --parallel api:serve proxy
  api:serve:
    cmds:
      - uv run python -m app.cli serve
  proxy:
    cmds:
      - caddy run --config Caddyfile --adapter caddyfile
  tailscale:
    desc: Private Tailscale HTTPS to Caddy
    cmds:
      - tailscale serve --bg http://127.0.0.1:8080
  test:
    cmds:
      - uv run pytest -q
  test:e2e:
    dir: frontend
    cmds:
      - pnpm exec playwright test
  screenshots:
    desc: Capture real browser screenshots
    dir: frontend
    cmds:
      - pnpm exec playwright test --config playwright.screenshots.config.ts
  check:
    cmds:
      - uv run ruff check app tests
      - uv run ty check app
      - task: api:check
      - task: ui:check
  ui:check:
    dir: frontend
    cmds:
      - pnpm lint
      - pnpm format:check
      - pnpm check
  fix:
    cmds:
      - uv run ruff check --fix app tests
      - uv run ruff format app tests
      - task: api:generate
      - task: ui:fix
  ui:fix:
    dir: frontend
    cmds:
      - pnpm lint:fix
      - pnpm format
  ui:format:
    dir: frontend
    cmds:
      - pnpm format
{% if enable_jobs %}
  jobs:redis:
    cmds:
      - docker compose up -d --wait redis
  jobs:worker:
    cmds:
      - uv run taskiq worker app.jobs:broker --workers 1
{% endif %}
{% if enable_terminal %}
  terminal:
    desc: Run ttyd on loopback as unprivileged user
    cmds:
      - ttyd -i 127.0.0.1 -p 7681 -b /terminal -O -W -m 1 /bin/bash
{% endif %}

