version: '3'
tasks:
  default:
    cmds: [task --list-all]
  install:
    desc: Install backend and frontend dependencies
    cmds:
      - task: api:install
      - task: ui:install
      - task: api:generate
  api:install:
    cmds:
      - uv sync
  ui:install:
    dir: frontend
    cmds:
      - pnpm install --no-frozen-lockfile
  setup:
    desc: Install dependencies and initialize database
    cmds:
      - task: install
      - task: db:init
      - task: ui:format
      - task: browser:install
      - task: hooks:install
  db:init:
    desc: Initialize SQLite database
    cmds:
      - uv run python -m app.cli init-db
  hooks:install:
    desc: Install pre-commit hooks in Git projects
    status:
      - uv run python -c "from pathlib import Path; import sys; sys.exit(0 if not Path('.git').exists() else 1)"
    cmds:
      - uv run pre-commit install
  api:generate:
    desc: Export FastAPI OpenAPI and regenerate typed frontend client
    cmds:
      - uv run python -m app.cli openapi
      - task: ui:api:generate
  ui:api:generate:
    dir: frontend
    cmds:
      - pnpm api:generate
  api:check:
    desc: Fail if generated TypeScript API types are stale
    cmds:
      - uv run python -m app.cli openapi
      - task: ui:api:check
  ui:api:check:
    dir: frontend
    cmds:
      - pnpm api:check
  dev:
    desc: API and Vite hot reload
    cmds:
      - task: api:generate
      - task --parallel api:dev ui:dev
  api:dev:
    cmds:
      - uv run python -m app.cli serve --reload
  ui:dev:
    dir: frontend
    cmds:
      - pnpm dev
  build:
    desc: Build frontend and Python distribution
    cmds:
      - task: api:generate
      - task: ui:build
      - task: api:build
  api:build:
    desc: Build Python wheel and source distribution
    cmds:
      - uv build
  ui:build:
    dir: frontend
    cmds:
      - pnpm build
  ui:preview:
    dir: frontend
    cmds:
      - pnpm preview
  ui:serve:
    cmds:
      - task: ui:build
      - task: ui:preview
  serve:
    desc: Run API and Caddy after building
    cmds:
      - task --parallel api:serve proxy
  api:serve:
    cmds:
      - uv run python -m app.cli serve
  proxy:
    cmds:
      - caddy run --config Caddyfile --adapter caddyfile
  tailscale:
    desc: Private Tailscale HTTPS to Caddy
    cmds:
      - tailscale serve --bg http://127.0.0.1:8080
  test:
    desc: Run backend tests (optional pytest arguments after --)
    cmds:
      - uv run pytest -q {% raw %}{{.CLI_ARGS}}{% endraw +%}
  test:all:
    desc: Run backend and browser tests
    cmds:
      - task: test
      - task: test:e2e
  test:ci:
    desc: Backend tests with JUnit report
    cmds:
      - uv run pytest -q --benchmark-disable --junitxml=backend.xml
  benchmark:
    desc: Run backend performance benchmarks
    cmds:
      - uv run pytest -q --benchmark-only {% raw %}{{.CLI_ARGS}}{% endraw +%}
  browser:install:
    desc: Install Chromium for Playwright
    dir: frontend
    cmds:
      - pnpm exec playwright install chromium
  browser:install-deps:
    desc: Install Chromium and Linux OS dependencies if needed
    dir: frontend
    cmds:
      - pnpm exec playwright install --with-deps chromium
  test:e2e:
    dir: frontend
    cmds:
      - pnpm exec playwright test {% raw %}{{.CLI_ARGS}}{% endraw +%}
  test:e2e:ci:
    desc: Run browser tests against prebuilt assets and produce JUnit report
    dir: frontend
    env:
      PLAYWRIGHT_JUNIT_OUTPUT_FILE: browser.xml
      APP_PREBUILT: '1'
    cmds:
      - pnpm exec playwright test --reporter=list,junit
  screenshots:
    desc: Capture real browser screenshots
    dir: frontend
    cmds:
      - pnpm exec playwright test --config playwright.screenshots.config.ts
  check:
    cmds:
      - task: api:check-code
      - task: api:check
      - task: ui:check
  api:check-code:
    cmds:
      - uv run ruff check app tests
      - uv run ty check app
  ui:check:
    dir: frontend
    cmds:
      - pnpm lint
      - pnpm format:check
      - pnpm check
  fix:
    cmds:
      - uv run ruff check --fix app tests
      - uv run ruff format app tests
      - task: api:generate
      - task: ui:fix
  ui:fix:
    dir: frontend
    cmds:
      - pnpm lint:fix
      - pnpm format
  ui:add:
    desc: Add shadcn-svelte components (names after --)
    dir: frontend
    cmds:
      - pnpm exec shadcn-svelte add {% raw %}{{.CLI_ARGS}}{% endraw +%}
  api:add:
    desc: Add Python dependencies (arguments after --)
    cmds:
      - uv add {% raw %}{{.CLI_ARGS}}{% endraw +%}
  api:remove:
    desc: Remove Python dependencies (arguments after --)
    cmds:
      - uv remove {% raw %}{{.CLI_ARGS}}{% endraw +%}
  ui:dependency:add:
    desc: Add frontend dependencies (arguments after --)
    dir: frontend
    cmds:
      - pnpm add {% raw %}{{.CLI_ARGS}}{% endraw +%}
  ui:dependency:remove:
    desc: Remove frontend dependencies (arguments after --)
    dir: frontend
    cmds:
      - pnpm remove {% raw %}{{.CLI_ARGS}}{% endraw +%}
  hooks:check:
    desc: Run pre-commit against all tracked files
    cmds:
      - uv run pre-commit run --all-files
  hooks:ruff:
    cmds:
      - uv run ruff check --fix {% raw %}{{.CLI_ARGS}}{% endraw +%}
  hooks:ruff-format:
    cmds:
      - uv run ruff format {% raw %}{{.CLI_ARGS}}{% endraw +%}
  hooks:eslint:
    cmds:
      - uv run python scripts/frontend_hook.py eslint {% raw %}{{.CLI_ARGS}}{% endraw +%}
  hooks:prettier:
    cmds:
      - uv run python scripts/frontend_hook.py prettier {% raw %}{{.CLI_ARGS}}{% endraw +%}
  ui:format:
    dir: frontend
    cmds:
      - pnpm format
{% if enable_rss %}
  rss:publish:
    desc: Publish an RSS announcement (title, description and optional --link after --)
    cmds:
      - uv run python -m app.cli publish-feed {% raw %}{{.CLI_ARGS}}{% endraw +%}
{% endif %}
{% if enable_jobs %}
  jobs:redis:
    cmds:
      - docker compose up -d --wait redis
  jobs:stop:
    desc: Stop Redis
    cmds:
      - docker compose stop redis
  jobs:worker:
    cmds:
      - uv run taskiq worker app.jobs:broker --workers 1
{% endif %}
{% if enable_terminal %}
  terminal:
    desc: Run ttyd on loopback as unprivileged user
    cmds:
      - ttyd -i 127.0.0.1 -p 7681 -b /terminal -O -W -m 1 /bin/bash
{% endif %}

