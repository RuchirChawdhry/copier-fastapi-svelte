import json
from pathlib import Path

import uvicorn
from cyclopts import App

from .config import get_settings
from .db import Database

cli = App(help="Manage the application.")


@cli.command
def serve(port: int = 8000, *, reload: bool = False) -> None:
    """Run the API on loopback."""
    uvicorn.run("app.api:app", host="127.0.0.1", port=port, reload=reload)


@cli.command
def init_db() -> None:
    Database(get_settings().database).initialize()


@cli.command
def notes() -> None:
    print(json.dumps(Database(get_settings().database).notes()))


@cli.command
def openapi(output: Path = Path("frontend/openapi.json")) -> None:
    """Export the current API contract without starting the server."""
    from .api import app

    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(app.openapi(), indent=2, sort_keys=True) + "\n", encoding="utf-8")


{% if enable_rss %}
@cli.command
def publish_feed(title: str, description: str, *, link: str | None = None) -> None:
    """Publish a deliberate public announcement to the RSS feed."""
    from .rss import publish

    print(publish(title, description, link))


{% endif %}
if __name__ == "__main__":
    cli()

