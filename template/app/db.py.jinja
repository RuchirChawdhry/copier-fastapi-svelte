import sqlite3
from collections.abc import Generator
from contextlib import contextmanager
from datetime import UTC, datetime
from pathlib import Path


class Database:
    def __init__(self, path: Path):
        self.path = path

    @contextmanager
    def connect(self) -> Generator[sqlite3.Connection]:
        connection = sqlite3.connect(self.path, timeout=5)
        connection.row_factory = sqlite3.Row
        try:
            connection.execute("PRAGMA foreign_keys=ON")
            connection.execute("PRAGMA synchronous=NORMAL")
            with connection:
                yield connection
        finally:
            connection.close()

    def initialize(self) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        with self.connect() as connection:
            connection.execute("PRAGMA journal_mode=WAL")
            connection.execute("BEGIN IMMEDIATE")
            connection.execute(
                "CREATE TABLE IF NOT EXISTS notes (id INTEGER PRIMARY KEY, text TEXT NOT NULL, created_at TEXT)"
            )
            if "created_at" not in {row["name"] for row in connection.execute("PRAGMA table_info(notes)")}:
                connection.execute("ALTER TABLE notes ADD COLUMN created_at TEXT")

{% if enable_events %}
            connection.execute(
                "CREATE TABLE IF NOT EXISTS note_revision (id INTEGER PRIMARY KEY, revision INTEGER NOT NULL)"
            )
            connection.execute("INSERT OR IGNORE INTO note_revision VALUES (1, 0)")
            for operation in ("INSERT", "UPDATE", "DELETE"):
                connection.execute(
                    f"CREATE TRIGGER IF NOT EXISTS notes_revision_{operation.lower()} "
                    f"AFTER {operation} ON notes BEGIN "
                    "UPDATE note_revision SET revision = revision + 1 WHERE id = 1; END"
                )
{% endif %}
{% if enable_rss %}
            connection.execute(
                "CREATE TABLE IF NOT EXISTS feed_items ("
                "id INTEGER PRIMARY KEY, guid TEXT NOT NULL UNIQUE, title TEXT NOT NULL, "
                "description TEXT NOT NULL, link TEXT NOT NULL, published TEXT NOT NULL)"
            )
{% endif %}

{% if enable_events %}
    def note_revision(self) -> int:
        with self.connect() as connection:
            return int(connection.execute("SELECT revision FROM note_revision WHERE id = 1").fetchone()[0])

{% endif %}
    def ready(self) -> bool:
        with self.connect() as connection:
            connection.execute("SELECT id FROM notes LIMIT 1").fetchall()
            return connection.execute("PRAGMA journal_mode").fetchone()[0] == "wal"

    def notes(self) -> list[dict]:
        with self.connect() as connection:
            return [dict(row) for row in connection.execute("SELECT id, text, created_at FROM notes ORDER BY id")]

    def add_note(self, text: str) -> dict:
        with self.connect() as connection:
            created_at = datetime.now(UTC).isoformat().replace("+00:00", "Z")
            cursor = connection.execute("INSERT INTO notes (text, created_at) VALUES (?, ?)", (text, created_at))
            return {"id": cursor.lastrowid, "text": text, "created_at": created_at}

    def delete_note(self, note_id: int) -> bool:
        with self.connect() as connection:
            return connection.execute("DELETE FROM notes WHERE id = ?", (note_id,)).rowcount > 0

