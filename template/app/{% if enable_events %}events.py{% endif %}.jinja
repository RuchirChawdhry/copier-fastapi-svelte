import asyncio
import logging
import sqlite3
from collections.abc import AsyncGenerator
from contextlib import asynccontextmanager, suppress

from .db import Database

logger = logging.getLogger(__name__)


class NoteEvents:
    """One revision monitor per API process; subscribers never query SQLite."""

    def __init__(self, database: Database, interval: float = 1.0):
        self.database = database
        self.interval = interval
        self.revision = 0
        self.changed = asyncio.Condition()

    async def refresh(self) -> None:
        revision = await asyncio.to_thread(self.database.note_revision)
        async with self.changed:
            if revision != self.revision:
                self.revision = revision
                self.changed.notify_all()

    async def run(self) -> None:
        while True:
            await asyncio.sleep(self.interval)
            try:
                await self.refresh()
            except sqlite3.Error:
                logger.exception("Could not read note revision; retrying")

    @asynccontextmanager
    async def monitor(self):
        await self.refresh()
        task = asyncio.create_task(self.run())
        try:
            yield
        finally:
            task.cancel()
            with suppress(asyncio.CancelledError):
                await task

    async def subscribe(self) -> AsyncGenerator[dict[str, str]]:
        previous = None
        while True:
            async with self.changed:
                await self.changed.wait_for(lambda: self.revision != previous)
                previous = self.revision
            yield {"event": "notes-changed", "data": str(previous)}
