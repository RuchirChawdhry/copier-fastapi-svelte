<!doctype html>
<html lang="en" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
{% if enable_rss %}
    <link rel="alternate" type="application/rss+xml" title="Application updates" href="/feed.rss" />
{% endif %}
    <title>{{ project_name | e }}</title>
    <script>
      try {
        const saved = localStorage.getItem('theme');
        const theme = ['dark','light','oled','solarized-light','solarized-dark'].includes(saved) ? saved : 'dark';
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.toggle('dark', !['light','solarized-light'].includes(theme));
      } catch {}
    </script>

  </head>
  <body>
    <div id="app"></div>
    <script type="module" src="/src/main.ts"></script>
  </body>
</html>
