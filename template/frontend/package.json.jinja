{
  "name": {{ project_slug | tojson }},
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {"node": ">=24"},
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "openapi-typescript openapi.json -o src/lib/generated/api.d.ts",
    "api:check": "openapi-typescript openapi.json -o src/lib/generated/api.d.ts --check"
  },
  "dependencies": {
    "svelte": "^5.57.2",
    "openapi-fetch": "^0.15.0",
    "@tanstack/svelte-table": "^9.0.0",
    "paneforge": "^1.0.0",
    "@tanstack/svelte-form": "^1.0.0",
    "@tanstack/svelte-query": "^6.0.0",
{% if enable_schema_forms %}
    "@sjsf/form": "^3.9.0",
    "@sjsf/basic-theme": "^3.9.0",
    "@sjsf/ajv8-validator": "^3.9.0",
    "ajv": "^8.17.1",
    "esm-env": "^1.2.0",
{% endif %}
    "zod": "^4.0.0",
    "@internationalized/date": "^3.0.0",
    "bits-ui": "^2.22.0",
    "@lucide/svelte": "^1.80.0",
    "@fontsource-variable/inter": "^5.3.0",
    "cn": "^0.5.2",
    "svelte-sonner": "^1.2.3",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.0",
    "eslint": "^10.0.0",
    "@eslint/js": "^10.0.0",
    "typescript-eslint": "^8.50.0",
    "eslint-plugin-svelte": "^3.14.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.5.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@playwright/test": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "shadcn-svelte": "1.8.2",
    "typescript": "^5.9.3",
    "svelte-check": "^4.7.6",
