<script lang="ts">
{% if enable_events %}
  import { onMount } from 'svelte';
{% endif %}
  import { createQuery, createMutation, useQueryClient } from '@tanstack/svelte-query';
  import { notesOptions, healthOptions } from '$lib/queries';
  import { Toaster, toast } from 'svelte-sonner';
{% if enable_rss %}
  import Rss from '@lucide/svelte/icons/rss';
  import Copy from '@lucide/svelte/icons/copy';
{% endif %}
  import Bell from '@lucide/svelte/icons/bell';
  import Sun from '@lucide/svelte/icons/sun';
  import Moon from '@lucide/svelte/icons/moon';
  import Monitor from '@lucide/svelte/icons/monitor';
  import Sunset from '@lucide/svelte/icons/sunset';
  import MoonStar from '@lucide/svelte/icons/moon-star';
  import Accessibility from '@lucide/svelte/icons/accessibility';
  import MessageSquare from '@lucide/svelte/icons/message-square';
  import { Switch } from 'bits-ui';
  import { preferences, setPreference } from '$lib/preferences.svelte';
  import Search from '@lucide/svelte/icons/search';
  import LayoutDashboard from '@lucide/svelte/icons/layout-dashboard';
  import Settings from '@lucide/svelte/icons/settings';
  import RefreshCw from '@lucide/svelte/icons/refresh-cw';
  import Database from '@lucide/svelte/icons/database';
  import Activity from '@lucide/svelte/icons/activity';
  import FileText from '@lucide/svelte/icons/file-text';
  import { Button } from '$lib/components/ui/button/index.js';
  import * as Command from '$lib/components/ui/command/index.js';
  import { PaneGroup, Pane, PaneResizer } from 'paneforge';
  import NoteForm from '$lib/NoteForm.svelte';
{% if enable_schema_forms %}
  import SchemaNoteForm from '$lib/SchemaNoteForm.svelte';
{% endif %}
  import NotesTable from '$lib/NotesTable.svelte';
  import Diagnostics from '$lib/Diagnostics.svelte';
  import { api{% if enable_events %}, type Note{% endif %} } from '$lib/api';
  import { themes, applyTheme, currentTheme, type Theme } from '$lib/theme';
  import { notify, requestNotifications } from '$lib/notifications';
{% if enable_terminal %}
  import Terminal from '$lib/Terminal.svelte';
{% endif %}

  const themeIcons = { dark: Moon, light: Sun, oled: Monitor, 'solarized-light': Sunset, 'solarized-dark': MoonStar };
  let theme = $state<Theme>(currentTheme());
  const switchClass = 'inline-flex h-6 w-11 shrink-0 items-center rounded-full border border-input bg-input p-0.5 transition-colors data-[state=checked]:bg-primary focus-visible:outline-2 focus-visible:outline-ring disabled:opacity-50';
  const thumbClass = 'block size-5 rounded-full bg-background shadow transition-transform data-[state=checked]:translate-x-5';
  let palette = $state(false);
  let page = $state<'workspace' | 'settings' | 'diagnostics'>('workspace');
  const queryClient = useQueryClient();
  const notesQuery = createQuery(() => notesOptions);
  const healthQuery = createQuery(() => healthOptions);
  const notes = $derived(notesQuery.data ?? []);
  const health = $derived(healthQuery.data);
  const addMutation = createMutation(() => ({
    mutationFn: api.add,
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: notesOptions.queryKey });
      notify('Note saved');
    },
  }));
  const removeMutation = createMutation(() => ({
    mutationFn: api.remove,
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: notesOptions.queryKey });
      notify('Note deleted');
    },
  }));
  let selectedId = $state<number | null>(null);
  let selected = $derived(notes.find(note => note.id === selectedId));
  let dark = $derived(!['light', 'solarized-light'].includes(theme));

  function setTheme(value: Theme) {
    theme = value;
    applyTheme(value);
  }

  function action(run: () => void) {
    palette = false;
    run();
  }

{% if enable_rss %}
  async function copyFeed() {
    try {
      await navigator.clipboard.writeText(new URL('/feed.rss', location.origin).href);
      notify('Feed URL copied');
    } catch (error) {
      toast.error(String(error));
    }
  }

{% endif %}
  function keyboard(event: KeyboardEvent) {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      palette = !palette;
    }
  }

  async function refresh() {
    await Promise.all([notesQuery.refetch(), healthQuery.refetch()]);
  }

  async function add(text: string) {
    await addMutation.mutateAsync(text);
  }

  async function remove(id: number) {
    try {
      await removeMutation.mutateAsync(id);
    } catch (error) {
      toast.error(String(error));
    }
  }

{% if enable_events %}
  onMount(() => {
    const stream = new EventSource('/api/events');
    let initialized = false;
    stream.addEventListener('notes', (event: MessageEvent<string>) => {
      const incoming: Note[] = JSON.parse(event.data);
      const changed = JSON.stringify(incoming) !== JSON.stringify(notes);
      if (changed) queryClient.setQueryData(notesOptions.queryKey, incoming);
      if (initialized && changed) notify('Notes updated', true);
      initialized = true;
    });
    return () => stream.close();
  });
{% endif %}
</script>

<svelte:window onkeydown={keyboard} />
<Toaster theme={dark ? 'dark' : 'light'} position="bottom-right" richColors />
<div class="min-h-screen bg-background text-foreground">
  <header class="sticky top-0 z-10 flex h-14 items-center gap-3 border-b bg-background px-4 md:px-6">
    <div class="grid size-8 place-items-center rounded-md bg-primary font-bold text-primary-foreground">A</div>
    <span class="font-semibold">{{ project_name | e }}</span>
    <div class="flex-1"></div>
    <Button variant="outline" onclick={() => palette = true}><Search class="size-4" /> Search commands <kbd class="ml-4 text-xs text-muted-foreground">Ctrl K</kbd></Button>
  </header>
  <div class="mx-auto grid max-w-screen-2xl md:grid-cols-[220px_1fr]">
    <aside class="flex gap-2 border-b p-4 md:min-h-[calc(100vh-56px)] md:flex-col md:border-r md:border-b-0">
      <p class="hidden px-3 py-2 text-xs font-medium uppercase tracking-widest text-muted-foreground md:block">Workspace</p>
      <Button variant={page === 'workspace' ? 'secondary' : 'ghost'} class="justify-start" onclick={() => page = 'workspace'}><LayoutDashboard class="size-4" /> Overview</Button>
      <Button variant={page === 'settings' ? 'secondary' : 'ghost'} class="justify-start" onclick={() => page = 'settings'}><Settings class="size-4" /> Settings</Button>
      <Button variant={page === 'diagnostics' ? 'secondary' : 'ghost'} class="justify-start" onclick={() => page = 'diagnostics'}><Activity class="size-4" /> Diagnostics</Button>
      <div class="flex-1"></div>
{% if enable_rss %}
      <a class="flex items-center gap-2 px-3 py-2 text-sm text-muted-foreground" href="/feed.rss" target="_blank" rel="noopener noreferrer"><Rss aria-hidden="true" class="size-4 shrink-0" /> RSS feed</a>
{% endif %}
      <a class="hidden px-3 py-2 text-xs text-muted-foreground md:block" href="/api/health" target="_blank" rel="external noreferrer">API health ↗</a>
    </aside>
    <main class="space-y-6 p-5 md:p-9">
      {#if page === 'workspace'}
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div><p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">Application</p><h1 class="mt-1 text-3xl font-semibold tracking-tight">Overview</h1></div>
          <Button variant="outline" onclick={refresh} disabled={notesQuery.isFetching || healthQuery.isFetching}><RefreshCw class="size-4" /> Refresh</Button>
        </div>
        <div class="grid gap-3 sm:grid-cols-3">
          <div class="rounded-lg border bg-card p-5"><p class="flex items-center gap-2 text-sm text-muted-foreground"><Activity class="size-4" /> API readiness</p><p class="mt-2 text-xl font-semibold">{health?.status ?? 'Unknown'}</p></div>
          <div class="rounded-lg border bg-card p-5"><p class="flex items-center gap-2 text-sm text-muted-foreground"><Database class="size-4" /> Database</p><p class="mt-2 text-xl font-semibold">{health?.dependencies.sqlite ?? 'Unknown'}</p></div>
          <div class="rounded-lg border bg-card p-5"><p class="flex items-center gap-2 text-sm text-muted-foreground"><FileText class="size-4" /> Saved notes</p><p class="mt-2 text-xl font-semibold">{notes.length}</p></div>
        </div>
        <section class="rounded-lg border bg-card p-5">
          <h2 class="text-lg font-semibold">Notes</h2>
          <p class="mb-5 text-sm text-muted-foreground">A working example of API, persistence and context menus.</p>
          <NoteForm onSave={add} />
          {#if notesQuery.isError}
            <p role="alert" class="mb-3 text-sm text-destructive">{notesQuery.error.message}</p>
          {:else if notesQuery.isPending}
            <p role="status" class="mb-3 text-sm text-muted-foreground">Loading notes…</p>
          {/if}
          <PaneGroup direction="horizontal" autoSaveId="notes-layout">
            <Pane defaultSize={70} minSize={40}>
              <div class="pr-3"><NotesTable {notes} onRemove={remove} onSelect={(note) => selectedId = note.id} /></div>
            </Pane>
            <PaneResizer class="w-2 rounded bg-border hover:bg-ring focus-visible:bg-ring" />
            <Pane defaultSize={30} minSize={20}>
              <div class="pl-4">
                <h3 class="mb-2 text-sm font-medium">Note details</h3>
                {#if selected}
                  <p class="mb-2 font-mono text-xs text-muted-foreground">ID {selected.id}</p>
                  <p class="break-all text-sm">{selected.text}</p>
                {:else}
                  <p class="text-sm text-muted-foreground">Select a note to inspect it.</p>
                {/if}
              </div>
            </Pane>
          </PaneGroup>
        </section>
{% if enable_schema_forms %}
        <SchemaNoteForm onSave={add} />
{% endif %}
{% if enable_terminal %}
        <Terminal />
{% endif %}
      {:else if page === 'diagnostics'}
        <Diagnostics />
      {:else}
        <h1 class="text-3xl font-semibold tracking-tight">Settings</h1>
        <section class="rounded-lg border bg-card p-5">
          <h2 class="text-lg font-semibold">Appearance</h2>
          <p class="mb-4 text-sm text-muted-foreground">Theme preference is saved on this browser.</p>
          <div class="flex flex-wrap gap-2">
            {#each themes as option (option.id)}
              <Button variant={theme === option.id ? 'default' : 'outline'} aria-pressed={theme === option.id} onclick={() => setTheme(option.id)}>{option.label}</Button>
            {/each}
          </div>
        </section>
        <section class="rounded-lg border bg-card p-5">
          <h2 class="flex items-center gap-2 text-lg font-semibold"><Bell class="size-5" aria-hidden="true" /> Notifications</h2>
          <p class="mb-4 text-sm text-muted-foreground">Control which notifications this browser displays.</p>
          <div class="flex items-center justify-between gap-4 border-b py-4">
            <div>
              <label for="success-toasts" class="flex items-center gap-2 font-medium"><MessageSquare class="size-4" aria-hidden="true" /> Success notifications</label>
              <p id="success-description" class="mt-1 text-sm text-muted-foreground">Show a toast when an operation succeeds. Errors always remain visible.</p>
            </div>
            <Switch.Root id="success-toasts" aria-describedby="success-description" checked={preferences.successToasts} onCheckedChange={(value) => setPreference('successToasts', value)} class={switchClass}><Switch.Thumb class={thumbClass} /></Switch.Root>
          </div>
          <div class="flex items-center justify-between gap-4 py-4">
            <div>
              <label for="desktop-notifications" class="flex items-center gap-2 font-medium"><Monitor class="size-4" aria-hidden="true" /> Desktop notifications</label>
              <p id="desktop-description" class="mt-1 text-sm text-muted-foreground">Allow browser notifications while the application is open, subject to browser permission.</p>
            </div>
            <Switch.Root id="desktop-notifications" aria-describedby="desktop-description" checked={preferences.desktopNotifications} onCheckedChange={(value) => value ? void requestNotifications() : setPreference('desktopNotifications', false)} class={switchClass}><Switch.Thumb class={thumbClass} /></Switch.Root>
          </div>
          <Button variant="outline" onclick={() => { toast.success('Notification test'); if (preferences.desktopNotifications && 'Notification' in window && Notification.permission === 'granted') new Notification('Notification test'); }}><Bell class="size-4" aria-hidden="true" /> Test notification</Button>
        </section>
        <section class="rounded-lg border bg-card p-5">
          <h2 class="flex items-center gap-2 text-lg font-semibold"><Accessibility class="size-5" aria-hidden="true" /> Accessibility</h2>
          <div class="flex items-center justify-between gap-4 pt-4">
            <div>
              <label for="reduced-motion" class="font-medium">Reduce motion</label>
              <p id="motion-description" class="mt-1 text-sm text-muted-foreground">Minimize transitions, animations and smooth scrolling.</p>
            </div>
            <Switch.Root id="reduced-motion" aria-describedby="motion-description" checked={preferences.reducedMotion} onCheckedChange={(value) => setPreference('reducedMotion', value)} class={switchClass}><Switch.Thumb class={thumbClass} /></Switch.Root>
          </div>
        </section>
      {/if}
    </main>
  </div>
</div>

<Command.Dialog bind:open={palette}>
  <Command.Input placeholder="Type a command…" />
  <Command.List>
    <Command.Empty>No commands found.</Command.Empty>
    <Command.Group heading="Navigation">
      <Command.Item value="open overview" onSelect={() => action(() => page = 'workspace')}><LayoutDashboard aria-hidden="true" data-menu-icon="" class="size-4 shrink-0" /> Open overview</Command.Item>
      <Command.Item value="open settings" onSelect={() => action(() => page = 'settings')}><Settings aria-hidden="true" data-menu-icon="" class="size-4 shrink-0" /> Open settings</Command.Item>
      <Command.Item value="open diagnostics" onSelect={() => action(() => page = 'diagnostics')}><Activity aria-hidden="true" data-menu-icon="" class="size-4 shrink-0" /> Open diagnostics</Command.Item>
      <Command.Item value="refresh data" onSelect={() => action(refresh)}><RefreshCw aria-hidden="true" data-menu-icon="" class="size-4 shrink-0" /> Refresh data</Command.Item>
      <Command.Item value="test notification" onSelect={() => action(() => notify('Notification test', true))}><Bell aria-hidden="true" data-menu-icon="" class="size-4 shrink-0" /> Test notification</Command.Item>
    </Command.Group>
{% if enable_rss %}
    <Command.Group heading="Syndication">
      <Command.Item value="open rss feed" onSelect={() => action(() => { window.open('/feed.rss', '_blank', 'noopener,noreferrer'); })}><Rss aria-hidden="true" data-menu-icon="" class="size-4 shrink-0" /> Open RSS feed</Command.Item>
      <Command.Item value="copy rss feed url" onSelect={() => action(copyFeed)}><Copy aria-hidden="true" data-menu-icon="" class="size-4 shrink-0" /> Copy RSS feed URL</Command.Item>
    </Command.Group>
{% endif %}
    <Command.Group heading="Appearance">
      {#each themes as option (option.id)}
        {@const Icon = themeIcons[option.id]}
        <Command.Item value={'theme ' + option.label} onSelect={() => action(() => setTheme(option.id))}><Icon aria-hidden="true" data-menu-icon="" class="size-4 shrink-0" /> Theme: {option.label}</Command.Item>
      {/each}
    </Command.Group>
  </Command.List>
</Command.Dialog>

