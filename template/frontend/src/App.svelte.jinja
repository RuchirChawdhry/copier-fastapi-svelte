<script lang="ts">
  import { Toaster{% if enable_rss %}, toast{% endif %} } from 'svelte-sonner';
  import * as Sidebar from '$lib/components/ui/sidebar/index.js';
  import WorkspaceSidebar from '$lib/shell/WorkspaceSidebar.svelte';
  import WorkspaceHeader from '$lib/shell/WorkspaceHeader.svelte';
  import CommandPalette from '$lib/shell/CommandPalette.svelte';
  import type { Page } from '$lib/shell/navigation';
  import { createWorkspace } from '$lib/features/notes/workspace.svelte';
  import Overview from './pages/Overview.svelte';
  import Settings from './pages/Settings.svelte';
  import Diagnostics from './pages/Diagnostics.svelte';
  import { applyTheme, currentTheme, type Theme } from '$lib/theme';
{% if enable_rss %}
  import { notify } from '$lib/notifications';
{% endif %}

  let theme = $state<Theme>(currentTheme());
  let palette = $state(false);
  let sidebarOpen = $state(!document.cookie.split('; ').includes('sidebar_state=false'));
  let page = $state<Page>('workspace');
  const workspace = createWorkspace();
  const dark = $derived(!['light', 'solarized-light'].includes(theme));

  function navigate(destination: Page) {
    page = destination;
  }

  function setTheme(value: Theme) {
    theme = value;
    applyTheme(value);
  }

{% if enable_rss %}
  async function copyFeed() {
    try {
      await navigator.clipboard.writeText(new URL('/feed.rss', location.origin).href);
      notify('Feed URL copied');
    } catch (error) {
      toast.error(String(error));
    }
  }

{% endif %}
</script>

<Toaster theme={dark ? 'dark' : 'light'} position="bottom-right" richColors />
<Sidebar.Provider bind:open={sidebarOpen} style="--sidebar-width: 14rem; --sidebar-width-icon: 3.25rem;">
  <WorkspaceSidebar projectName={{ project_name | tojson }} {page} onNavigate={navigate} />
  <Sidebar.Inset class="min-w-0 text-foreground">
    <WorkspaceHeader {page} onNavigate={navigate} onSearch={() => palette = true} onRefresh={workspace.refresh}{% if enable_rss %} onCopyFeed={copyFeed}{% endif %} />
    <div class="mx-auto w-full max-w-screen-2xl space-y-6 p-5 md:p-9">
      {#if page === 'workspace'}
        <Overview {workspace} />
      {:else if page === 'diagnostics'}
        <Diagnostics />
      {:else}
        <Settings {theme} {setTheme} />
      {/if}
    </div>
  </Sidebar.Inset>
</Sidebar.Provider>

<CommandPalette bind:open={palette} onNavigate={navigate} onRefresh={workspace.refresh} {setTheme}{% if enable_rss %} onCopyFeed={copyFeed}{% endif %} />
