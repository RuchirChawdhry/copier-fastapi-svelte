<script lang="ts">
  import { Separator } from '$lib/components/ui/separator/index.js';
  import { Kbd, KbdGroup } from '$lib/components/ui/kbd/index.js';
  import ResourceNavigation from '$lib/ResourceNavigation.svelte';
  import * as Sidebar from '$lib/components/ui/sidebar/index.js';
  import * as Dropdown from '$lib/components/ui/dropdown-menu/index.js';
  import * as Tooltip from '$lib/components/ui/tooltip/index.js';
  import Ellipsis from '@lucide/svelte/icons/ellipsis';
  import Keyboard from '@lucide/svelte/icons/keyboard';
  import ExternalLink from '@lucide/svelte/icons/external-link';
  import Search from '@lucide/svelte/icons/search';
  import Settings from '@lucide/svelte/icons/settings';
  import RefreshCw from '@lucide/svelte/icons/refresh-cw';
  import Activity from '@lucide/svelte/icons/activity';
  import { Button } from '$lib/components/ui/button/index.js';
{% if enable_rss %}
  import Rss from '@lucide/svelte/icons/rss';
{% endif %}

  type Page = 'workspace' | 'settings' | 'diagnostics';
  let { page, onNavigate, onSearch, onRefresh{% if enable_rss %}, onCopyFeed{% endif %} }: {
    page: Page;
    onNavigate: (page: Page) => void;
    onSearch: () => void;
    onRefresh: () => Promise<void>;
{% if enable_rss %}
    onCopyFeed: () => Promise<void>;
{% endif %}
  } = $props();
  const modifier = /Mac|iPhone|iPad/.test(navigator.platform) ? '⌘' : 'Ctrl';
</script>

<header class="sticky top-0 z-10 flex h-14 items-center gap-3 border-b bg-background px-4 md:px-6">
  <Tooltip.Root>
    <Tooltip.Trigger>
      {#snippet child({ props })}
        <Sidebar.Trigger {...props} aria-label="Toggle sidebar" />
      {/snippet}
    </Tooltip.Trigger>
    <Tooltip.Content><span>Toggle sidebar</span> <KbdGroup><Kbd>{modifier}</Kbd><Kbd>B</Kbd></KbdGroup></Tooltip.Content>
  </Tooltip.Root>
  <Separator orientation="vertical" class="!h-5" />
  <span class="truncate text-sm font-medium">{page === 'workspace' ? 'Overview' : page === 'settings' ? 'Settings' : 'Diagnostics'}</span>
  <div class="flex-1"></div>
  <ResourceNavigation />
  <Button variant="outline" onclick={onSearch} aria-label="Search commands"><Search class="size-4" /><span class="hidden sm:inline">Search commands</span><KbdGroup class="ml-2 hidden sm:inline-flex"><Kbd>{modifier}</Kbd><Kbd>K</Kbd></KbdGroup></Button>
  <Tooltip.Root>
    <Tooltip.Trigger>
      {#snippet child({ props })}
        <Button {...props} variant="outline" size="icon" aria-label="Open settings" aria-current={page === 'settings' ? 'page' : undefined} onclick={() => onNavigate('settings')}><Settings class="size-4" aria-hidden="true" /></Button>
      {/snippet}
    </Tooltip.Trigger>
    <Tooltip.Content>Settings</Tooltip.Content>
  </Tooltip.Root>
  <Dropdown.Root>
    <Dropdown.Trigger>
      {#snippet child({ props })}
        <Button {...props} variant="outline" size="icon" aria-label="Workspace actions"><Ellipsis class="size-4" /></Button>
      {/snippet}
    </Dropdown.Trigger>
    <Dropdown.Content align="end" class="w-56">
      <Dropdown.Group>
        <Dropdown.Label>Workspace actions</Dropdown.Label>
        <Dropdown.Item onSelect={onRefresh}><RefreshCw aria-hidden="true" /> Refresh data</Dropdown.Item>
        <Dropdown.Item onSelect={onSearch}><Keyboard aria-hidden="true" /> Search commands <Dropdown.Shortcut>{modifier}+K</Dropdown.Shortcut></Dropdown.Item>
        <Dropdown.Item onSelect={() => onNavigate('settings')}><Settings aria-hidden="true" /> Open settings</Dropdown.Item>
        <Dropdown.Item onSelect={() => onNavigate('diagnostics')}><Activity aria-hidden="true" /> Diagnostics</Dropdown.Item>
      </Dropdown.Group>
      <Dropdown.Separator />
      <Dropdown.Group>
        <Dropdown.Label>Resources</Dropdown.Label>
        <Dropdown.Item onSelect={() => window.open('/docs', '_blank', 'noopener,noreferrer')}><ExternalLink aria-hidden="true" /> API documentation</Dropdown.Item>
{% if enable_rss %}
        <Dropdown.Item onSelect={onCopyFeed}><Rss aria-hidden="true" /> Copy RSS feed URL</Dropdown.Item>
{% endif %}
      </Dropdown.Group>
    </Dropdown.Content>
  </Dropdown.Root>
</header>
