{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true, "skipLibCheck": true,
    "isolatedModules": true, "verbatimModuleSyntax": true, "noEmit": true,
    "paths": {"$lib/*": ["./src/lib/*"]}, "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts", "playwright.config.ts", "tests/**/*.ts"]
}

