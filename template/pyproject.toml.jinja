[project]
name = {{ project_slug | tojson }}
version = "0.1.0"
requires-python = ">=3.14"
dependencies = [
  "fastapi", "uvicorn[standard]", "cyclopts", "pydantic-settings", "psutil",
{% if enable_ntfy %}
  "httpx",
{% endif %}
{% if enable_rss %}
  "feedgenerator>=2.2.1,<3",
{% endif %}
{% if enable_mcp %}
  "fastmcp>=2,<3",
{% endif %}
{% if enable_events %}
  "sse-starlette",
{% endif %}
{% if enable_jobs %}
  "redis>=5", "taskiq", "taskiq-redis", "taskiq-fastapi",
{% endif %}
]
[project.scripts]
{{ project_slug }} = "app.cli:cli"
[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"
[tool.hatch.build.targets.wheel]
packages = ["app"]
[tool.hatch.build.targets.sdist]
exclude = ["/tools", "/tests/test_dev_mcp.py", "/frontend/scripts/dev-browser.mjs"]
[dependency-groups]
dev = ["fastmcp>=2,<3", "pyyaml", "httpx", "pytest", "pytest-benchmark", "ruff", "ty", "pre-commit"]
[tool.ruff]
target-version = "py314"
line-length = 100
[tool.ruff.lint]
select = ["E4", "E7", "E9", "F", "I"]
[tool.pytest.ini_options]
testpaths = ["tests"]

