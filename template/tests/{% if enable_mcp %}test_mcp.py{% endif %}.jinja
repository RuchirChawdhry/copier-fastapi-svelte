from mcp.shared.inbound import MCP_METHOD_HEADER, MCP_NAME_HEADER, MCP_PROTOCOL_VERSION_HEADER
from mcp_types import (
    CLIENT_CAPABILITIES_META_KEY,
    CLIENT_INFO_META_KEY,
    PROTOCOL_VERSION_META_KEY,
    SERVER_INFO_META_KEY,
)


def test_application_mcp(client):
    protocol = "2026-07-28"
    meta = {
        PROTOCOL_VERSION_META_KEY: protocol,
        CLIENT_INFO_META_KEY: {"name": "template-test", "version": "1.0"},
        CLIENT_CAPABILITIES_META_KEY: {},
    }

    def call(method, request_id, **params):
        headers = {
            "Accept": "application/json, text/event-stream",
            "Host": "127.0.0.1",
            MCP_PROTOCOL_VERSION_HEADER: protocol,
            MCP_METHOD_HEADER: method,
        }
        if method == "tools/call":
            headers[MCP_NAME_HEADER] = params["name"]
        response = client.post(
            "/mcp/", headers=headers,
            json={"jsonrpc": "2.0", "id": request_id, "method": method,
                  "params": {"_meta": meta, **params}},
        )
        assert response.status_code == 200, response.text
        return response.json()["result"]

    discovery = call("server/discover", 1)
    assert protocol in discovery["supportedVersions"]
    assert discovery["_meta"][SERVER_INFO_META_KEY]["name"].endswith("-app")
    assert {tool["name"] for tool in call("tools/list", 2)["tools"]} == {"list_notes"}
    result = call("tools/call", 3, name="list_notes", arguments={})
    assert not result.get("isError", False)
    assert result["content"]
